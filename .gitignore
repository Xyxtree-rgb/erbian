# ==========================================================
# 耳辩 · erbian-hackathon
# 提交比赛仓库前的安全清单：密钥、运行数据、打包产物一律不传
# ==========================================================

# ---- 1. 敏感信息（最高优先级，绝不能进仓库）----
.env
.env.*
*.env
.env.local
!.env.example
config_local.py
secrets.*
*.pem
*.key

# ---- 2. 运行产生的数据与日志 ----
*.db
*.sqlite
*.sqlite3
stats.db
*.log
*.err
_serve.log
server.err
server.log
*.log.*

# ---- 3. Python ----
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
*.egg
venv/
.venv/
env/

# ---- 4. 打包产物（build 101MB + dist 32MB）----
build/
dist/
*.exe
*.pkg
*.app
*.pyz

# ---- 5. 临时 / 预览 / 调试产物 ----
_preview/
_fg.html
_pg.html
_h_hint.html
_serve_preview.py
_remote_v2.sh
*.tmp
*.bak
*.bak-*
*.orig.*
*原版备份*

# ---- 6. 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
